{
  "name": "fitapp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || ^22.12.0 || ^24.0.0" },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
