# Copiar a api/.env y completar. api/.env no se versiona.
PORT=3401
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitapp
DB_PASSWORD=
DB_NAME=fitapp
DB_NAME_TEST=fitapp_test
# true en producción (HTTPS). En localhost por HTTP tiene que ser false.
COOKIE_SECURE=false

# IA opcional. Sin clave, modelo, límite positivo y marcas, queda desactivada.
AI_API_KEY=
AI_MODEL=
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
AI_MONTHLY_REQUEST_LIMIT=0
AI_BRANDS=
